{
  "buildCommand": "sh scripts/build-site.sh",
  "outputDirectory": "site",
  "installCommand": "true",
  "framework": null,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Referrer-Policy", "value": "strict-origin" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
